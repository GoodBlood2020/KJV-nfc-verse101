{
  "functions": {
    "api/verse.js": {
      "includeFiles": "verses.kjv.references.json"
    }
  },
  "redirects": [
    {
      "source": "/media/daily-lift-chest-fly-test.mp4",
      "destination": "/media/exercise-preview.svg",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/media/exercise-preview.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml; charset=utf-8"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/media/daily-lift-latest.mp4",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
